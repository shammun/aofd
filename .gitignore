# AOFD Vallis — public repo shammun/aofd. PLANNING §2.6 + the credential block from the 2026-10-20 session.

# --- environments and caches ---
.venv/
.venv-*/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
*.log
~$*
~WRL*.tmp

# --- never public: the book and anything derived from it (CLAUDE.md rule 9) ---
*.pdf
*.zip
*.docx
chapters/*
!chapters/_page_map.json
_private/
tests/book_values_*.json

# --- local products ---
outputs/
reports/viz/
reports/movies/
notebooks/executed_*.ipynb

# --- data: raw downloads live on G:, only small derived products are committed ---
*.nc
*.npz
*.zarr/
!data/derived/**/*.nc
!data/derived/**/*.npz
data/raw/
data/cache/

# --- movies ---
movies/out/
movies/.cache/
movies/**/audio/

# --- credentials: never commit (tools/check_secrets.py also blocks them in hooks) ---
.cdsapirc
*netrc
.env
.env.*
*credential*
*secret*
!tools/check_secrets.py
!tools/secrets_vault.py
!tools/setup_credentials.py
!CREDENTIALS_GUIDE.md
*.pem
*.key
*.p12
.copernicusmarine*
# screenshots and scans dropped in the repo root (they can show passwords/tokens)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.heic
/*.pdf
# movie real-data binaries: regenerated by data/real/fetch_real_data.py from the G: derived products (headers + checks are committed)
movies/**/data/real/*.bin
movies/**/data/real/*.jpg
movies/**/data/real/*.png
movies/**/data/real/__pycache__/
# movie trail binaries: regenerated by movies/data/build_*.py from the real-data products (headers + hashes in manifest)
movies/**/data/trails_*.bin

# VidNotes review downloads (user content, never committed)
ant_reviews/

# movies render staging (regenerated by movies/data/build_*.py; sound mixes are copied here before renders)
movies/public/
